# Local SQLite database. On Vercel, set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# TURSO_DATABASE_URL takes precedence over a local file: DATABASE_URL.
DATABASE_URL=file:./cyberguard.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=cyberguard-super-secret-key-32-characters-minimum-length
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=notifications@cyberguard.ai
AI_PROVIDER=mock
AI_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
